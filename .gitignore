# Public-repository privacy invariants.
#
# This repository is PUBLIC. Real-site testing evidence must never enter it:
# a diagnostic bundle contains real page structure and could contain
# operator-specific content even after redaction.
test-results/live/
diagnostic-analysis/
*.diagnostic.zip
*.diag.zip
artifacts/live-test/*/*.zip

# Live-test artifacts are build outputs, reproducible from the commit their
# MANIFEST names. Only the MANIFEST is committed so the handoff is auditable;
# the bundle itself is rebuilt locally by `pnpm live:prepare <ID>`.
artifacts/live-test/*/jobpilot.diagnostic.user.js
