{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first, rule-driven job application assistant userscript",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:vue",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "verify:dist": "tsx scripts/verify-build.ts",
    "verify:diagnostic": "tsx scripts/verify-diagnostic-build.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm verify:dist && pnpm build:diagnostic && pnpm verify:diagnostic && pnpm diag:selftest",
    "check:all": "pnpm check && pnpm test:browser",
    "build:diagnostic": "node scripts/run-build.mjs diagnostic",
    "diag:analyze": "tsx scripts/analyze-bundle.ts",
    "diag:compare": "tsx scripts/compare-bundles.ts",
    "diag:selftest": "tsx scripts/diag-selftest.ts",
    "build:all": "node scripts/run-build.mjs production --clean && node scripts/run-build.mjs diagnostic",
    "live:prepare": "tsx scripts/prepare-live-artifact.ts",
    "recon:dom": "tsx scripts/recon/live-dom-recon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "camoufox": "^0.1.19",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-monkey": "7.1.9",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "vue": "^3.5.43"
  }
}
